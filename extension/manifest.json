{
  "manifest_version": 3,
  "name": "avow",
  "version": "0.1.0",
  "description": "Fills Play Console declarations from an avow manifest you pick. Never submits, never connects anywhere.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "avow: fill Play Console declarations from your manifest",
    "default_icon": {
      "16": "icons/icon16.png",
      "24": "icons/icon24.png",
      "32": "icons/icon32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://play.google.com/console/*"
      ],
      "js": [
        "src/load.js",
        "src/questions.js",
        "src/fill.js",
        "src/actions.js",
        "src/panel.js",
        "src/bridge.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
